# ------------------------------------------------------------------------------
# Krypton Monorepo Root .gitignore
# ------------------------------------------------------------------------------

# Dependencies & Package Managers
node_modules/
.pnpm-store/
.bun-cache/
.pnp/
.pnp.*
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Debug & Execution Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# Scratch & Temporary Testing Directories
scratch/
.scratch/

# Next.js & Frontend Build Artifacts
.next/
out/
output/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Rust & Tauri Native Builds
target/
**/src-tauri/target/
**/*.rs.bk
apps/desktop/src-tauri/binaries/*
!apps/desktop/src-tauri/binaries/.gitkeep

# Executables & Native Binaries (Heavy Files)
*.exe
*.dll
*.so
*.dylib
*.dylib.*
*.o
*.obj
*.a
*.lib
*.pdb
*.pdb.*

# Local CLI Executables & Generated Batch Wrappers
krypton
krypton.exe
krypton.cmd
*.cmd
packages/cli/krypton
packages/cli/krypton.exe
packages/cli/krypton.cmd

# Krypton Local Runtime Artifacts (~/.krypton and local runtime dumps)
.krypton/
**/cache/outputs/*
**/pty_sessions/*
**/worktrees/*
credentials.enc
*.enc

# Python Sandbox & Starter Scaffolding
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Playwright & Browser Automation
test-results/
playwright-report/
.playwright/
browser_profiles/
browser_binaries/

# Test Coverage
coverage/
*.lcov

# Environment Variables & Secret Credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/**/workspace.xml
.idea/**/shelf/
.idea/**/httpRequests/
.idea/**/dataSources/
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
*.swp
*.swo
*~
